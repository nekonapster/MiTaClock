# Entorno de ejecución: development | production | test
NODE_ENV="development"

# Puerto HTTP del servidor (Render inyecta PORT automáticamente)
PORT="3000"

# Cadena de conexión pooled a PostgreSQL en Neon (requiere sslmode=require en producción)
DATABASE_URL=

# Cadena de conexión directa/unpooled en Neon (opcional, usada solo al ejecutar migraciones al arrancar)
DATABASE_URL_UNPOOLED=

# Cadena de conexión separada para ejecutar las pruebas sobre una base de pruebas real (si se omite, Vitest usa PGlite local en memoria)
TEST_DATABASE_URL=

# Secreto para firmar las cookies de sesión JWT (OBLIGATORIO y robusto >= 32 caracteres en NODE_ENV=production)
JWT_SECRET=

# Modo de integración con MiTa v2.0 (fake hasta conectar el adaptador HTTP de producción)
MITA_MODE="fake"

# Clave opcional para autenticar llamadas server-to-server desde MiTa v2.0 (Laravel 12)
MITA_SYNC_KEY=

# Siembra 1 admin y 3 empleados de ejemplo solo cuando la tabla users está vacía
SEED_DEMO_DATA="false"

# Contraseña inicial opcional para las cuentas sembradas cuando SEED_DEMO_DATA=true (requiere cambio en primer acceso si DEMO_MUST_CHANGE_PASSWORD=true)
SEED_DEMO_PASSWORD=

# Exigir cambio de contraseña en el primer acceso demo (true recomendado en producción; false en desarrollo)
DEMO_MUST_CHANGE_PASSWORD="true"

# Habilita los botones de acceso rápido demo en login (recomendado false en producción)
ALLOW_DEMO_AUTH="false"

# Bootstrap opcional de un administrador inicial (útil al estrenar una BD PostgreSQL/Neon vacía con SEED_DEMO_DATA=false)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_RESET="false"

# Ventana máxima en días hacia atrás para solicitar correcciones
CORRECTION_LOOKBACK_DAYS="7"
